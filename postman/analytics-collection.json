                }
              ]
            },
            "description": "Konnect only accepts 15M, 1H, 6H, 12H, 24H and 7D as relative ranges. Anything longer has to be an absolute start/end pair."
          }
        },
        {
          "name": "Rejects a window outside the 14 day retention",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The profile and region guards run before any request validation, so",
                  "// these checks need both present. Placeholders are fine: with a region",
                  "// set the wrapper resolves the base URL without ever loading the profile.",
                  "pm.variables.set('guardProfileId', pm.collectionVariables.get('profileId') || 'validation-placeholder');",
                  "pm.variables.set('guardControlPlaneId', pm.collectionVariables.get('controlPlaneId') || '00000000-0000-0000-0000-000000000000');",
                  "pm.collectionVariables.set('staleStart', new Date(Date.now() - 30 * 86400000).toISOString());",
                  "pm.collectionVariables.set('staleEnd', new Date(Date.now() - 29 * 86400000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('explains the retention limit', () => pm.expect(pm.response.json().error.message).to.include('retention'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/summary?controlPlaneId={{guardControlPlaneId}}&start={{staleStart}}&end={{staleEnd}}&region={{region}}&profileId={{guardProfileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "summary"
              ],
              "query": [
                {
                  "key": "controlPlaneId",
                  "value": "{{guardControlPlaneId}}"
                },
                {
                  "key": "start",
                  "value": "{{staleStart}}"
                },
                {
                  "key": "end",
                  "value": "{{staleEnd}}"
                },
                {
                  "key": "region",
                  "value": "{{region}}"
                },
                {
                  "key": "profileId",
                  "value": "{{guardProfileId}}"
                }
              ]
            },
            "description": "Konnect keeps 14 days and answers an older window with an empty result set rather than an error, which reads as 'no traffic'. The wrapper rejects it instead."
          }
        },
        {
          "name": "Rejects a misspelled filter field",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The profile and region guards run before any request validation, so",
                  "// these checks need both present. Placeholders are fine: with a region",
                  "// set the wrapper resolves the base URL without ever loading the profile.",
                  "pm.variables.set('guardProfileId', pm.collectionVariables.get('profileId') || 'validation-placeholder');",
                  "pm.variables.set('guardControlPlaneId', pm.collectionVariables.get('controlPlaneId') || '00000000-0000-0000-0000-000000000000');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('names the bad field and lists valid ones', () => {",
                  "  const m = pm.response.json().error.message;",
                  "  pm.expect(m).to.include('sevice_name');",
