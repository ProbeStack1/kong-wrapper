                  "value": "{{controlPlaneId}}"
                },
                {
                  "key": "region",
                  "value": "{{region}}"
                }
              ]
            },
            "description": "The analytics routes carry the same profile and region guards as the rest of the management API. Without them a request would silently fall back to the KONNECT_PAT in the service environment."
          }
        },
        {
          "name": "Rejects an unsupported relative range",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The profile and region guards run before any request validation, so",
                  "// these checks need both present. Placeholders are fine: with a region",
                  "// set the wrapper resolves the base URL without ever loading the profile.",
                  "pm.variables.set('guardProfileId', pm.collectionVariables.get('profileId') || 'validation-placeholder');",
                  "pm.variables.set('guardControlPlaneId', pm.collectionVariables.get('controlPlaneId') || '00000000-0000-0000-0000-000000000000');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('lists the ranges Konnect accepts', () => {",
                  "  const m = pm.response.json().error.message;",
                  "  pm.expect(m).to.include('15M');",
                  "  pm.expect(m).to.include('7D');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/summary?controlPlaneId={{guardControlPlaneId}}&timeRange=30D&region={{region}}&profileId={{guardProfileId}}",
              "host": [
