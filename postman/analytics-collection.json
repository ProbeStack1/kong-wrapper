                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"controlPlaneId\": \"{{guardControlPlaneId}}\",\n  \"filters\": [\n    { \"field\": \"sevice_name\", \"operator\": \"in\", \"value\": [\"anything\"] }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/summary?region={{region}}&profileId={{guardProfileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analytics",
                "summary"
              ],
              "query": [
                {
                  "key": "region",
                  "value": "{{region}}"
                },
                {
                  "key": "profileId",
                  "value": "{{guardProfileId}}"
                }
              ]
            },
            "description": "Konnect answers an unknown filter field with zero rows and no error, so a typo looks exactly like a quiet gateway. The wrapper validates fields against a known set first."
          }
